@startuml task1-abstract-factory
title Завдання 1. Підготовка номера за категорією — Abstract Factory
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "lab10.src.task1" {
  class Main <<Runner>> {
    + {static} main(args: String[]): void
    - {static} runTask1(): void
    - {static} runTask2(): void
    - {static} runTask3(): void
  }

  class Task1RoomPreparation <<Task 1 implementation and demo>> {
    + {static} main(args: String[]): void
    ~ {static} demoThreeCategories(service: HousekeepingService): void
    ~ {static} demoNewCategoryChalet(service: HousekeepingService): void
  }

  interface "Task1RoomPreparation.RoomItem" as RoomItem {
    + category(): String
    + describe(): String
  }
  interface "Task1RoomPreparation.CosmeticsSet" as CosmeticsSet
  interface "Task1RoomPreparation.MinibarContent" as MinibarContent
  interface "Task1RoomPreparation.Textile" as Textile

  abstract class "Task1RoomPreparation.BaseItem" as BaseItem {
    - category: String
    - title: String
    - content: String
    + category(): String
    + describe(): String
  }

  class "Task1RoomPreparation.StandardCosmetics" as StandardCosmetics
  class "Task1RoomPreparation.StandardMinibar" as StandardMinibar
  class "Task1RoomPreparation.StandardTextile" as StandardTextile
  class "Task1RoomPreparation.LuxeCosmetics" as LuxeCosmetics
  class "Task1RoomPreparation.LuxeMinibar" as LuxeMinibar
  class "Task1RoomPreparation.LuxeTextile" as LuxeTextile
  class "Task1RoomPreparation.FamilyCosmetics" as FamilyCosmetics
  class "Task1RoomPreparation.FamilyMinibar" as FamilyMinibar
  class "Task1RoomPreparation.FamilyTextile" as FamilyTextile
  class "Task1RoomPreparation.ChaletCosmetics" as ChaletCosmetics
  class "Task1RoomPreparation.ChaletMinibar" as ChaletMinibar
  class "Task1RoomPreparation.ChaletTextile" as ChaletTextile

  interface "Task1RoomPreparation.RoomKitFactory" as RoomKitFactory <<AbstractFactory>> {
    + category(): String
    + createCosmetics(): CosmeticsSet
    + createMinibar(): MinibarContent
    + createTextile(): Textile
  }
  class "Task1RoomPreparation.StandardRoomKitFactory" as StandardRoomKitFactory <<ConcreteFactory>>
  class "Task1RoomPreparation.LuxeRoomKitFactory" as LuxeRoomKitFactory <<ConcreteFactory>>
  class "Task1RoomPreparation.FamilyRoomKitFactory" as FamilyRoomKitFactory <<ConcreteFactory>>
  class "Task1RoomPreparation.ChaletRoomKitFactory" as ChaletRoomKitFactory <<ConcreteFactory>>

  class "Task1RoomPreparation.HousekeepingService" as HousekeepingService <<Client>> {
    - {static} SOURCE: String
    + prepareRoom(roomNumber: String, factory: RoomKitFactory): void
  }
}

package "lab10.src.task2" {
  class "lab10.src.task2.Main" as Task2Main <<Runner>> {
    + {static} run(): void
  }
}
package "lab10.src.task3" {
  class "lab10.src.task3.Main" as Task3Main <<Runner>> {
    + {static} run(): void
  }
}

class Log <<utility>> {
  - {static} minutes: int
  + {static} event(source: String, text: String): void
}

RoomItem <|-- CosmeticsSet
RoomItem <|-- MinibarContent
RoomItem <|-- Textile
RoomItem <|.. BaseItem

BaseItem <|-- StandardCosmetics
BaseItem <|-- StandardMinibar
BaseItem <|-- StandardTextile
BaseItem <|-- LuxeCosmetics
BaseItem <|-- LuxeMinibar
BaseItem <|-- LuxeTextile
BaseItem <|-- FamilyCosmetics
BaseItem <|-- FamilyMinibar
BaseItem <|-- FamilyTextile
BaseItem <|-- ChaletCosmetics
BaseItem <|-- ChaletMinibar
BaseItem <|-- ChaletTextile

CosmeticsSet <|.. StandardCosmetics
CosmeticsSet <|.. LuxeCosmetics
CosmeticsSet <|.. FamilyCosmetics
CosmeticsSet <|.. ChaletCosmetics
MinibarContent <|.. StandardMinibar
MinibarContent <|.. LuxeMinibar
MinibarContent <|.. FamilyMinibar
MinibarContent <|.. ChaletMinibar
Textile <|.. StandardTextile
Textile <|.. LuxeTextile
Textile <|.. FamilyTextile
Textile <|.. ChaletTextile

RoomKitFactory <|.. StandardRoomKitFactory
RoomKitFactory <|.. LuxeRoomKitFactory
RoomKitFactory <|.. FamilyRoomKitFactory
RoomKitFactory <|.. ChaletRoomKitFactory

HousekeepingService ..> RoomKitFactory : <<uses>>
HousekeepingService ..> CosmeticsSet : <<uses>>
HousekeepingService ..> MinibarContent : <<uses>>
HousekeepingService ..> Textile : <<uses>>
HousekeepingService ..> Log : <<uses>>
Task1RoomPreparation ..> HousekeepingService : runs demos
Task1RoomPreparation ..> StandardRoomKitFactory : creates
Task1RoomPreparation ..> LuxeRoomKitFactory : creates
Task1RoomPreparation ..> FamilyRoomKitFactory : creates
Task1RoomPreparation ..> ChaletRoomKitFactory : creates
Main ..> Task1RoomPreparation : runs
Main ..> Task2Main : runs
Main ..> Task3Main : runs

StandardRoomKitFactory ..> StandardCosmetics : <<creates>>
StandardRoomKitFactory ..> StandardMinibar : <<creates>>
StandardRoomKitFactory ..> StandardTextile : <<creates>>
LuxeRoomKitFactory ..> LuxeCosmetics : <<creates>>
LuxeRoomKitFactory ..> LuxeMinibar : <<creates>>
LuxeRoomKitFactory ..> LuxeTextile : <<creates>>
FamilyRoomKitFactory ..> FamilyCosmetics : <<creates>>
FamilyRoomKitFactory ..> FamilyMinibar : <<creates>>
FamilyRoomKitFactory ..> FamilyTextile : <<creates>>
ChaletRoomKitFactory ..> ChaletCosmetics : <<creates>>
ChaletRoomKitFactory ..> ChaletMinibar : <<creates>>
ChaletRoomKitFactory ..> ChaletTextile : <<creates>>

note right of HousekeepingService
  Не знає конкретних класів
  і не розгалужується за категорією.
  Нова категорія = нові класи,
  без змін у службі.
end note
@enduml
