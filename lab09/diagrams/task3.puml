@startuml
!pragma layout smetana
title Завдання 3 — Prototype: пакети проживання

class StayPackage {
  - packageName: String
  - guestName: String
  - includedServices: List~String~
  - spaProcedures: List~String~
  - skiPassDays: int
  - discountPercent: BigDecimal
  + StayPackage(packageName: String, includedServices: List~String~, spaProcedures: List~String~, skiPassDays: int, discountPercent: BigDecimal)
  + copyForGuest(guestName: String): StayPackage
  + getPackageName(): String
  + getGuestName(): String
  + getIncludedServices(): List~String~
  + getSpaProcedures(): List~String~
  + getSkiPassDays(): int
  + getDiscountPercent(): BigDecimal
  + addIncludedService(service: String): void
  + removeIncludedService(service: String): void
  + addSpaProcedure(procedure: String): void
  + removeSpaProcedure(procedure: String): void
  + setSkiPassDays(days: int): void
  + setDiscountPercent(percent: BigDecimal): void
  + toString(): String
  - StayPackage(packageName: String, guestName: String, includedServices: List~String~, spaProcedures: List~String~, skiPassDays: int, discountPercent: BigDecimal)
  - requireText(value: String, fieldName: String): String
  - copyTextList(values: List~String~, fieldName: String): List~String~
}

class Task3Demo {
  - Task3Demo()
  + {static} main(args: String[]): void
  + {static} runDemo(): void
  - {static} verifyIndependentCopies(template: StayPackage, customizedPackage: StayPackage, unchangedPackage1: StayPackage, unchangedPackage2: StayPackage): void
}

Task3Demo ..> StayPackage : creates prototypes
StayPackage ..> StayPackage : copies itself for a guest
note right of StayPackage
  copyForGuest creates fresh service lists,
  so package customization is isolated.
end note
@enduml
